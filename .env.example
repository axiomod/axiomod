# Copy to .env and adjust for your environment.
# Used by docker-compose.reference.yaml; never commit a real .env file.

POSTGRES_USER=axiomod
POSTGRES_PASSWORD=change-me

# Application overrides (Viper env prefix APP_, dots become underscores)
# APP_AUTH_JWT_SECRETKEY must be at least 32 bytes.
APP_AUTH_JWT_SECRETKEY=
APP_DATABASE_PASSWORD=
