{
  "allowedDependencies": {
    "framework/*": [
      "framework/*"
    ],
    "platform/*": [
      "framework/*",
      "platform/*"
    ],
    "plugins": [
      "framework/*",
      "platform/*"
    ],
    "plugins/*": [
      "framework/*",
      "platform/*",
      "plugins"
    ],
    "cmd/*": [
      "*"
    ],
    "tests/*": [
      "*"
    ],
    "scripts": [
      "*"
    ]
  },
  "exceptions": [
    "_test.go",
    "mock_",
    "testdata",
    "platform/ent/schema",
    "platform/ent/migrate",
    "platform/ent/runtime",
    ".pb.go"
  ],
  "patternRules": [
    {
      "pattern": "examples/*",
      "allowedToImport": "framework/*",
      "explanation": "Domain code may use framework packages (errors, observability, validation)"
    },
    {
      "pattern": "examples/*",
      "allowedToImport": "examples/*",
      "explanation": "Intra-domain imports; cross-domain isolation is enforced by domainRules and `validator domain`"
    },
    {
      "pattern": "examples/*/infrastructure/*",
      "allowedToImport": "platform/*",
      "explanation": "Infrastructure adapters may use platform components such as platform/ent"
    },
    {
      "pattern": "examples/*",
      "allowedToImport": "platform/server",
      "explanation": "Domain module wiring registers HTTP/gRPC routes against the platform server"
    },
    {
      "pattern": "examples/*",
      "allowedToImport": "platform/ent",
      "explanation": "Domain modules may construct the Ent client when database.orm=ent"
    },
    {
      "pattern": "examples/*/cmd/*",
      "allowedToImport": "*",
      "explanation": "Example application entry points assemble the full fx graph, like cmd/*"
    }
  ],
  "domainRules": {
    "allowCrossDomainDependencies": false,
    "allowedCrossDomainImports": [
      {
        "source": "examples/example",
        "target": "platform",
        "explanation": "Example domain can import platform components"
      }
    ],
    "allowedInternalStructure": {
      "entity": [],
      "repository": [
        "entity"
      ],
      "usecase": [
        "entity",
        "repository",
        "service"
      ],
      "service": [
        "entity",
        "repository"
      ],
      "delivery/http": [
        "usecase",
        "entity",
        "middleware"
      ],
      "delivery/grpc": [
        "usecase",
        "entity"
      ],
      "infrastructure/persistence": [
        "entity",
        "repository"
      ],
      "infrastructure/cache": [
        "entity"
      ],
      "infrastructure/messaging": [
        "entity"
      ]
    }
  }
}
